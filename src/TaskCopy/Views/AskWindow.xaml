<Window x:Class="TaskCopy.Views.AskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskCopy"
        Width="390"
        Height="206"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Mocha.Base.Brush}"
        Foreground="{DynamicResource Mocha.Text.Brush}"
        FontFamily="{DynamicResource Mocha.Font}"
        FontSize="13"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="PromptLabel"
                   Style="{DynamicResource Mocha.Body.Section}"
                   Margin="0,0,0,10" />

        <TextBox Grid.Row="1"
                 x:Name="ValueBox"
                 Style="{DynamicResource Mocha.TextBox}"
                 KeyDown="OnKeyDown" />

        <PasswordBox Grid.Row="1"
                     x:Name="SecretBox"
                     Style="{DynamicResource Mocha.PasswordBox}"
                     Visibility="Collapsed"
                     KeyDown="OnKeyDown" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Style="{DynamicResource Mocha.Button}"
                    Content="Cancel"
                    Width="80"
                    IsCancel="True"
                    Click="OnCancel" />
            <Button Style="{DynamicResource Mocha.Button.Accent}"
                    Content="OK"
                    Width="80"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    Click="OnOk" />
        </StackPanel>
    </Grid>
</Window>
