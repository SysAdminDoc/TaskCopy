<Window x:Class="TaskCopy.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About TaskCopy"
        Width="460" Height="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Mocha.Base.Brush}"
        Foreground="{DynamicResource Mocha.Text.Brush}"
        FontFamily="{DynamicResource Mocha.Font}"
        FontSize="13"
        UseLayoutRounding="True">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="TaskCopy"
                   Style="{DynamicResource Mocha.Body.Title}" />

        <TextBlock Grid.Row="1"
                   x:Name="VersionText"
                   Style="{DynamicResource Mocha.Body.Subtle}"
                   Margin="0,4,0,0" />

        <TextBlock Grid.Row="2"
                   Text="Single-click clipboard snippet menu for Windows."
                   Style="{DynamicResource Mocha.Body.Caption}"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap" />

        <Border Grid.Row="3"
                Style="{DynamicResource Mocha.Panel}"
                Margin="0,16,0,0">
        <StackPanel>
            <TextBlock x:Name="UsageStatsText"
                       Style="{DynamicResource Mocha.Body.Section}"
                       Foreground="{DynamicResource Mocha.Mauve.Brush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <TextBlock Style="{DynamicResource Mocha.Body.Subtle}"
                       TextWrapping="Wrap"
                       Text="MIT licensed. Tray + global hotkey (Ctrl+Alt+V by default). Storage at %LOCALAPPDATA%\TaskCopy\." />
            <TextBlock x:Name="RepoLink"
                       Style="{DynamicResource Mocha.Body}"
                       Foreground="{DynamicResource Mocha.Blue.Brush}"
                       Cursor="Hand"
                       Text="https://github.com/SysAdminDoc/TaskCopy"
                       Margin="0,8,0,0"
                       MouseLeftButtonUp="OnOpenRepo" />
            <TextBlock x:Name="LicenseLink"
                       Style="{DynamicResource Mocha.Body}"
                       Foreground="{DynamicResource Mocha.Blue.Brush}"
                       Cursor="Hand"
                       Text="View LICENSE"
                       Margin="0,4,0,0"
                       MouseLeftButtonUp="OnOpenLicense" />
        </StackPanel>
        </Border>

        <Button Grid.Row="4"
                Style="{DynamicResource Mocha.Button}"
                Content="Close"
                HorizontalAlignment="Right"
                Width="92"
                IsCancel="True"
                Click="OnClose" />
    </Grid>
</Window>
